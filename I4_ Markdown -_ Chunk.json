    {
      "parameters": {
        "jsCode": "// Convert HTML to plain text and OVERWRITE `content`.\n\nfunction decodeHTMLEntities(s = '') {\n  const named = { amp:'&', lt:'<', gt:'>', quot:'\"', apos:\"'\", nbsp:' ', ensp:' ', emsp:' ', ndash:'-', mdash:'—' };\n  return String(s).replace(/&(#x?[0-9a-fA-F]+|[a-zA-Z]+);/g, (_, ent) => {\n    if (ent[0] === '#') {\n      const hex = ent[1]?.toLowerCase() === 'x';\n      const code = parseInt(ent.slice(hex ? 2 : 1), hex ? 16 : 10);\n      return Number.isFinite(code) ? String.fromCodePoint(code) : _;\n    }\n    return Object.prototype.hasOwnProperty.call(named, ent) ? named[ent] : _;\n  });\n}\n\nfunction htmlToText(html = '') {\n  let t = String(html);\n  t = t.replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n       .replace(/<style[\\s\\S]*?<\\/style>/gi, '');\n  t = t.replace(/<\\s*br\\s*\\/?>/gi, '\\n')\n       .replace(/<\\/\\s*p\\s*>/gi, '\\n');\n  t = t.replace(/<[^>]+>/g, '');\n  t = decodeHTMLEntities(t).replace(/\\u00A0/g, ' ');\n  t = t.replace(/[ \\t]+\\n/g, '\\n')\n       .replace(/\\n{3,}/g, '\\n\\n')\n       .replace(/[ \\t]{2,}/g, ' ')\n       .trim();\n  return t;\n}\n\nreturn items.map(it => {\n  // - it.json.text = Default output from \"Extract from File\" node\n  // - it.json.content = Default location from your raw API data\n  let rawContent = it.json.text || it.json.content || '';\n\n  let finalContent = rawContent;\n  // Only run the cleaner IF it's a string AND it contains something resembling an HTML tag (<something>)\n  if (typeof rawContent === 'string' && /<[^>]+>/.test(rawContent)) {\n    finalContent = htmlToText(rawContent);\n  }\n  return { \n    json: { \n        ...it.json,           // Keeps your file_path, language, etc.\n        content: finalContent // The guaranteed clean text\n    } \n  };\n});"
      },
