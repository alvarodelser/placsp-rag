    {
      "parameters": {
        "jsCode": "const base = $input.all()[0]?.json || {};\nconst chunksArray = base.chunks || [];\n\n// 1. Map the Chunks (Synergyos_chunks)\nconst chunkObjects = chunksArray.map(c => ({\n  class: \"Synergyos_chunks\",\n  tenant: base.repository_id,\n  vector: c.vector,\n  properties: {\n    repository_id: base.repository_id,\n    document_id: base.document_id,\n    document_type: base.document_type,\n    permissions_id: base.permissions_id,\n    title: base.title,\n    content: c.content ?? \"\", // chunk text\n    createdDateTime: base.createdDateTime,\n    modifiedDateTime: base.modifiedDateTime,\n    author: base.author,\n    editor: base.editor,\n    related: base.related,\n    file: (Array.isArray(base.file) && base.file.length > 0) ? base.file[0] : (base.file || null),\n    chunk: {\n      chunk_id: c.chunk_id,\n      chunk_total: c.chunk_total,\n      lang: c.lang,\n      token_number: c.token_number,\n      text_related: c.text_related || []\n    }\n  }\n}));\n\n// 2. Map the Full Text Document (Synergyos_full_text)\nconst fullTextObject = {\n  class: \"Synergyos_full_text\",\n  tenant: base.repository_id,\n  properties: {\n    repository_id: base.repository_id,\n    document_id: base.document_id,\n    permissions_id: base.permissions_id,\n    document_type: base.document_type,\n    title: base.title,\n    content: base.content || \"\", // full text\n    createdDateTime: base.createdDateTime,\n    modifiedDateTime: base.modifiedDateTime,\n    author: base.author,\n    editor: base.editor,\n    related: base.related,\n    file: (Array.isArray(base.file) && base.file.length > 0) ? base.file[0] : (base.file || null)\n  }\n};\n\n// 3. Combine into one batch\nreturn [{ \n  json: { \n    objects: [...chunkObjects, fullTextObject],\n    expected_count: chunkObjects.length + 1 \n  } \n}];\n"
      },
