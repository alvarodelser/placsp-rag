        "jsonBody": "{\n  \"match\": {\n    \"class\": \"Synergyos_full_text\",\n    \"where\": {\n      \"operator\": \"And\",\n      \"operands\": [\n        { \"path\": [\"repository_id\"], \"operator\": \"Equal\", \"valueText\": \"={{ $node[\\\"Build Chunk Metadata\\\"].json.repository_id }}\" },\n        { \"path\": [\"document_id\"],   \"operator\": \"Equal\", \"valueText\": \"={{ $node[\\\"Build Chunk Metadata\\\"].json.document_id }}\" }\n      ]\n    }\n  },\n  \"output\": \"minimal\"\n}\n",
