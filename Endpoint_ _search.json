    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body;\nconst { tenant, query } = body;\n\n// --- required fields ---\nif (!tenant || typeof tenant !== 'string' || !tenant.trim()) {\n  throw new Error(\"Missing 'repository'\");\n}\nif (!query || typeof query !== 'string' || !query.trim()) {\n  throw new Error(\"Missing 'query'\");\n}\n\n// --- permission_list (required array of non-empty strings) ---\n//if (!Array.isArray(body.permission_list)) {\n//  throw new Error(\"Missing or invalid 'permission_list'. Must be //array.\");\n//}\n\n// --- mode (enum) ---\nconst rawMode = String(body.mode || 'vector').toLowerCase();\nconst mode = ['vector','hybrid','doc_lexical','chunk_lexical'].includes(rawMode) ? rawMode : 'hybrid';\n\n// --- k (optional) ---\nlet k = Number(body.k ?? 5);\nif (!Number.isFinite(k) || k < 1) k = 5;\nif (k > 50) k = 50;\n\n\n// --- alpha (hybrid only) ---\nlet alpha = Number(body.alpha ?? 0.5);\nif (!Number.isFinite(alpha)) alpha = 0.5;\nif (alpha < 0) alpha = 0;\nif (alpha > 1) alpha = 1;\n\n// --- properties (optional array of strings) ---\nlet properties = Array.isArray(body.properties) ? body.properties : null;\n\n\n\n//let cleaned = body.permission_list\n//  .filter(v => typeof v === 'string')\n//  .map(s => s.trim())\n//  .filter(Boolean);\n\n//if (cleaned.length !== body.permission_list.length || //cleaned.length === 0) {\n//  throw new Error(\"'permission_list' must contain at least one non-empty string\");\n//}\n\n// simple safe characters\nconst idRegex = /^[A-Za-z0-9._-]{1,200}$/;\n//const invalid = cleaned.find(id => !idRegex.test(id));\n//if (invalid) {\n//  throw new Error(`Invalid permission id: ${invalid}`);\n//}\n\n// dedupe\nconst permission_list = null //[...new Set(cleaned)];\n\nreturn {\n  json: {\n    tenant: tenant.trim(),\n    query: query.trim(),\n    permission_list,\n    k,\n    mode,\n    alpha,\n    properties,\n  }\n};\n"
      },
