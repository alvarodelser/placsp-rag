{
  "name": "I5: Chunks->Vectors",
  "nodes": [
    {
      "parameters": {
        "content": "## Metadata\n- document_id\n- content\n### File metadata\n- file\n  - file.type\n  - file.size\n  - file.path\n\n### Chunk metadata\n- chunks[]\n  - chunks[].content\n  - chunks[].vector\n  - chunks[].chunk_id\n  - chunks[].chunk_total\n  - chunks[].lang\n  - chunks[].token_number",
        "height": 432,
        "width": 224
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1584,
        160
      ],
      "id": "cda29423-1162-487d-a1cf-6824475023af",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const input = item.json || {};\n\n  const chunksArray = input.chunk_list || [];\n  const tokensArray = input.token_count || [];\n  const vectorsArray = input.embeddings || [];\n  const chunkLang = input.chunk_language || input.language || null;\n  const chunkTotal = chunksArray.length;\n\n  const chunks = chunksArray.map((content, i) => ({\n    content: content ?? \"\",\n    vector: vectorsArray[i] || [],\n    chunk_id: i + 1,\n    chunk_total: chunkTotal,\n    lang: chunkLang,\n    token_number: tokensArray[i] ?? null,\n  }));\n\n  // Create a copy to prevent modifying the original item by reference\n  const result = {\n    ...input,\n    chunks,\n  };\n\n  // Explicitly delete the source arrays so they don't show up in the output\n  delete result.chunk_list;\n  delete result.chunk_title;\n  delete result.token_count;\n  delete result.embeddings;\n\n  return {\n    json: result\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        -80
      ],
