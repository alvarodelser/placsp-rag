# Copy to .env and fill in. Used by docker-compose.yml for the PLACSP Weaviate instance.

# API key the ingester must send (Authorization: Bearer <this>). Generate a strong value:
#   openssl rand -hex 32
WEAVIATE_API_KEY=change-me

# Host ports published by the container (change if they collide with other services).
WEAVIATE_HTTP_PORT=8087
WEAVIATE_GRPC_PORT=50052

# Soft memory ceiling for the Weaviate process.
WEAVIATE_GOMEMLIMIT=4GiB
