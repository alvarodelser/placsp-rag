    {
      "parameters": {
        "jsCode": "const className = Object.keys($json.data.Get)[0];\nconst raw = $json.data.Get[className] ?? [];\nconst source = \"vector\"; // change per node\n\nconst chunks = raw.map(r => {\n  const a = r._additional ?? {};\n\n  // Unified score: certainty for vector (already [0,1]), raw score for hybrid/bm25\n  const score = a.certainty\n    ?? (typeof a.score === \"string\" ? parseFloat(a.score) : a.score)\n    ?? null;\n\n  return {\n    id: a.id,\n    score,\n    score_detail: a.explainScore ?? null,  // hybrid only, null elsewhere\n    source,\n    class: className,\n    ...Object.fromEntries(Object.entries(r).filter(([k]) => k !== \"_additional\"))\n  };\n});\n\nreturn [{ json: { chunks } }];"
      },
      "type": "n8n-nodes-base.code",
