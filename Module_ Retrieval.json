              "name": "query",
              "value": "={{ `{\n  Get {\n    Synergyos_full_text(\n      tenant: ${JSON.stringify($json.tenant)},\n      bm25: { query: ${JSON.stringify($json.query)} },\n      ${$json.permission_list && $json.permission_list.length > 0\n        ? `where: {\n             operator: Or,\n             operands: [\n               ${$json.permission_list.map(p => `{ path: [\"permissions_id\"], operator: Equal, valueString: ${JSON.stringify(p)} }`).join(\",\")}\n             ]\n           },`\n        : \"\"}\n      limit: ${$json.k ?? 5}\n    ){\n      ${($json.properties ?? [\"document_id\", \"content\"]).join(\"\\n      \")}\n      _additional { id  score }\n    }\n  }\n}` }}\n"
            }
