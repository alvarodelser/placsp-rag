# Copy to .env and fill in values before running: docker compose up -d

# ── Weaviate ──────────────────────────────────────────────────────────────────
# Generate a strong key: openssl rand -hex 32
# The same value is used by Weaviate (auth) and the search-api (client auth).
WEAVIATE_API_KEY=change-me

# Host ports published by the Weaviate container (change if they conflict)
WEAVIATE_HTTP_PORT=8087
WEAVIATE_GRPC_PORT=50052

# Soft memory ceiling for the Weaviate process
WEAVIATE_GOMEMLIMIT=4GiB

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32. Host ports (localhost only) of placsp-qdrant.
QDRANT_API_KEY=change-me
QDRANT_HTTP_PORT=6343
QDRANT_GRPC_PORT=6344

# ── Search API ────────────────────────────────────────────────────────────────
SEARCH_API_PORT=8092
# BGE-M3 vectorizer (existing iarag container). It listens on the host's loopback only, so:
# - processes on the host (ingester, pilot) use VECTORIZER_URL;
# - the search-api container joins the vectorizer's network and calls it by name.
VECTORIZER_URL=http://localhost:8089
VECTORIZER_NETWORK=n8n-net
SEARCH_VECTORIZER_URL=http://vectorizer:8089

# Questions over the pilot's documents (Preguntar): hybrid retrieval, then the reranker
# container (placsp-reranker, text-embeddings-inference), then a small model on Ollama.
# ANSWER_OLLAMA_URL must be reachable from the search-api container (empty: passages only).
RERANKER_PORT=8095
# RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
ANSWER_OLLAMA_URL=
ANSWER_MODEL=gemma4:e4b
ANSWER_KEEP_ALIVE=30m

# Comma-separated allowed CORS origins. Set to your UI's public URL in production.
CORS_ORIGINS=*

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing key. Generate: openssl rand -hex 32
SECRET_KEY=change-me
# SQLite database for user accounts and saved items (mounted to placsp_feedback_data volume)
USERS_DB=/data/users.db

# ── Neo4j (company graph) ─────────────────────────────────────────────────────
# Required when the graph is enabled. Generate a strong value: openssl rand -hex 24
# placsp-init-graph creates the uniqueness constraints once Neo4j is up.
NEO4J_PASSWORD=change-me
# Host ports published by the Neo4j container (Browser UI / Bolt; change if they conflict)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# JVM heap ceiling for Neo4j
NEO4J_HEAP=2G

# ── Ingestion pipeline (host-side, not in Docker) ─────────────────────────────
# These are sourced by the cron/systemd ingester running on the host.
# WEAVIATE_URL=http://localhost:8087          # ingester on host → published port
# WEAVIATE_API_KEY=<same as above>
# VECTORIZER_URL=http://localhost:8089
# PLACSP_CODELIST_DIR=/opt/placsp/codelists
# PLACSP_DATA_DIR=/opt/placsp/data          # staging area: zips, versions, current tables, loaded.duckdb
# PLACSP_EXTRACT_WORKERS=2                  # archives extracted in parallel
# PLACSP_BUILD_MEMORY=4GB                   # DuckDB memory limit for the build
# PLACSP_EMBED_WORKERS=2                    # embedding requests in flight
# Enable the company graph from the host ingester (leave unset to disable the graph sink):
# NEO4J_URL=bolt://localhost:7687             # ingester on host → published Bolt port
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<same as above>
